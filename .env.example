# Base PostgreSQL (celle de docker-compose.yml en local).
DATABASE_URL="postgresql://chargerecup:chargerecup@localhost:5432/chargerecup?schema=public"

# Mot de passe de l'espace staff (/staff).
STAFF_PASSWORD="change-me"

# Secret qui signe le cookie staff. Chaîne aléatoire de 16 caractères minimum :
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Fuseau horaire de l'équipe : il décide du jour auquel une réponse est rattachée.
APP_TIMEZONE="Africa/Tunis"

# Facultatif : si défini, le lien des joueurs doit être  https://ton-site/?k=<valeur>
# Évite que n'importe qui envoie des réponses.
PLAYER_KEY=""
