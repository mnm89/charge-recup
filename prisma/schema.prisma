// Schéma de la base de données (PostgreSQL).
//
// Une ligne de `daily_entries` = la réponse d'un joueur pour un jour donné :
// 5 notes de bien-être du matin + les séances de la veille (0, 1 ou 2 lignes
// dans `training_sessions`). Il n'y a pas de table "joueurs" : les joueurs
// saisissent leur nom, et les variantes d'écriture sont regroupées à la lecture
// (voir src/lib/names.ts). Les données saisies ne sont donc jamais modifiées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionType {
  MUSCU    // Musculation
  TRAINING // Entraînement
  COMBO    // Combiné (musculation + entraînement)
  MATCH
  OTHER
}

model DailyEntry {
  id         String   @id @default(cuid())
  /// Nom tel que saisi par le joueur (40 caractères max).
  playerName String   @map("player_name") @db.VarChar(40)
  /// Nom normalisé (minuscules, sans accents, tirets). Sert de clé d'unicité par jour.
  nameKey    String   @map("name_key") @db.VarChar(60)
  /// Jour de la réponse, dans le fuseau APP_TIMEZONE. Les séances décrites sont celles de la veille.
  entryDate  DateTime @map("entry_date") @db.Date

  /// Notes de bien-être de 1 (très mauvais) à 5 (excellent).
  sleep      Int      @db.SmallInt
  fatigue    Int      @db.SmallInt
  soreness   Int      @db.SmallInt
  stress     Int      @db.SmallInt
  mood       Int      @db.SmallInt

  /// Vrai si le joueur n'a pas fait de séance la veille.
  isRest     Boolean  @default(false) @map("is_rest")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sessions   TrainingSession[]

  /// Renvoyer le questionnaire le même jour avec le même nom remplace la réponse.
  @@unique([nameKey, entryDate])
  @@index([entryDate])
  @@map("daily_entries")
}

model TrainingSession {
  id       String       @id @default(cuid())
  entryId  String       @map("entry_id")
  /// 0 = première séance, 1 = deuxième séance du jour.
  position Int          @db.SmallInt
  type     SessionType?
  /// Intensité ressentie, 0 à 10.
  rpe      Int          @db.SmallInt
  /// Durée en minutes, 1 à 300.
  minutes  Int          @db.SmallInt

  entry    DailyEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
  @@map("training_sessions")
}
